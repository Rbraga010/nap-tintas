# ============================================================
# NAP TINTAS — variaveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores do
# SEU projeto Supabase (Dashboard > Settings > API).
# Sem estas variaveis o site roda em MODO DEMO (catalogo de exemplo).
# ============================================================

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon/public (segura para uso no navegador; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
